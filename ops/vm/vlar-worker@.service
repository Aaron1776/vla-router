# One simulator worker in the sim image (docs/SPEC.md §12, §15; vlar_ops/vm_worker.py). Start several by hand after
# `vlar-ops queue resume` and once both model servers answer:  sudo systemctl start vlar-worker@{1..N}
# Not enabled at boot on purpose: after a preemption the queue is resumed first (ops/README.md, "Every start").
# The image tag comes from /etc/vlar/images.env (ops/vm/load_images.sh).
[Unit]
Description=vla-router simulator worker %i
After=network-online.target docker.service vlar-spend.service vlar-xvla.service vlar-pi05.service
Requires=docker.service

[Service]
EnvironmentFile=/etc/vlar/images.env
ExecStart=/usr/bin/docker run --rm --name vlar-worker-%i --gpus all --network host \
  -v /etc/vlar:/etc/vlar:ro -v /opt/vla-router/ops/ops.yaml:/etc/vlar-ops/ops.yaml:ro \
  -v /var/lib/vlar:/var/lib/vlar -e VLAR_OPS_CONFIG=/etc/vlar-ops/ops.yaml \
  vlar-sim:${VLAR_IMAGE_COMMIT} vlar-ops worker --worker-id w%i
# docker stop sends SIGTERM: the worker abandons its current job cleanly (lease released, no marker).
ExecStop=/usr/bin/docker stop -t 60 vlar-worker-%i
TimeoutStopSec=90
# exit status 3 = the worker refused a job its options cannot run
Restart=no
